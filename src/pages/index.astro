---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Astro + ACSS 4.x Starter">
  <main>
    <section class="l-section c-hero">
      <div class="l-container">
        <div class="c-hero__inner">
          <span class="c-hero__badge">Automatic.css 4.x Starter</span>
          <h1 class="c-hero__title">
            Architected with <span class="c-hero__highlight">Astro &amp; ACSS</span>
          </h1>
          <p class="c-hero__lead">
            A production-ready starter featuring fluid ACSS 4.x design tokens, BEM methodology, CSS logical properties, and zero runtime overhead.
          </p>
          <div class="c-hero__actions">
            <a href="https://github.com/gdcrosbie/astro-acss-starter" class="c-btn c-btn--primary">
              GitHub Repository
            </a>
            <a href="#features" class="c-btn c-btn--secondary">
              Explore Architecture
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="l-section l-section--bordered c-features">
      <div class="l-container">
        <header class="c-features__header">
          <span class="c-features__label">Design System Contract</span>
          <h2 class="c-features__title">Fluid Mathematical Primitives</h2>
        </header>

        <div class="c-features__grid">
          <article class="c-card">
            <h3 class="c-card__title">Verified ACSS 4.x Scale</h3>
            <p class="c-card__body">
              Pure fluid variables spanning `--space-xs` through `--space-xxl` with responsive bridge pairs (`--space-xl-to-m`).
            </p>
          </article>

          <article class="c-card">
            <h3 class="c-card__title">Strict BEM Architecture</h3>
            <p class="c-card__body">
              Every component uses isolated, scoped BEM selectors (`.c-block__element--modifier`) referencing design tokens via custom properties.
            </p>
          </article>

          <article class="c-card">
            <h3 class="c-card__title">CSS Logical Properties</h3>
            <p class="c-card__body">
              Flow-relative dimensions (`padding-block`, `margin-inline`, `max-inline-size`, `inset-block-start`) authored throughout.
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .c-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-inline-size: 840px;
  }

  .c-hero__badge {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--primary);
    background-color: color-mix(in oklch, var(--primary) 15%, transparent);
    border: 1px solid color-mix(in oklch, var(--primary) 30%, transparent);
    padding-block: 0.35em;
    padding-inline: 0.85em;
    border-radius: var(--radius-50, 50px);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-block-end: var(--space-m);
  }

  .c-hero__title {
    font-size: clamp(2.2rem, 5vw, var(--text-xxl));
    font-weight: 700;
    line-height: var(--heading-line-height, 1.15);
    color: var(--color);
    margin-block-end: var(--space-m);
    text-wrap: balance;
  }

  .c-hero__highlight {
    color: var(--primary);
  }

  .c-hero__lead {
    font-size: var(--text-m);
    color: var(--color-muted);
    line-height: var(--text-line-height, 1.6);
    max-inline-size: 65ch;
    margin-block-end: var(--space-xl);
  }

  .c-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  /* Buttons */
  .c-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-block: 0.6em;
    padding-inline: 1.4em;
    font-size: var(--text-s);
    font-weight: 600;
    border-radius: var(--radius);
    transition: var(--transition);
    text-decoration: none;
    line-height: 1;
    cursor: pointer;
    box-sizing: border-box;
  }

  .c-btn--primary {
    background-color: var(--primary);
    color: var(--primary-ultra-light);
    border: 1px solid var(--primary);
    box-shadow: var(--box-shadow-1);
  }

  .c-btn--primary:hover {
    background-color: var(--primary-hover);
    border-color: var(--primary-hover);
    color: var(--primary-ultra-light);
    transform: translateY(-1px);
  }

  .c-btn--secondary {
    background-color: var(--surface-raised);
    color: var(--color);
    border: 1px solid var(--border-color-dark);
    box-shadow: var(--box-shadow-1);
  }

  .c-btn--secondary:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-1px);
  }

  /* Features Section */
  .c-features__header {
    max-inline-size: 640px;
    margin-block-end: var(--space-xl);
  }

  .c-features__label {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-block-end: var(--space-xs);
  }

  .c-features__title {
    font-size: var(--h2);
    font-weight: 700;
    line-height: var(--heading-line-height, 1.2);
    color: var(--color);
  }

  .c-features__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--grid-gap, var(--space-m));
  }

  /* Cards */
  .c-card {
    background-color: var(--surface);
    border: 1px solid var(--border-color-dark);
    border-radius: var(--radius);
    padding: var(--space-l);
    box-shadow: var(--box-shadow-1);
    transition: var(--transition);
  }

  .c-card:hover {
    border-color: color-mix(in oklch, var(--white) 30%, transparent);
    box-shadow: var(--box-shadow-2);
    transform: translateY(-2px);
  }

  .c-card__title {
    font-size: var(--h3);
    font-weight: 700;
    color: var(--color);
    margin-block-end: var(--space-xs);
  }

  .c-card__body {
    font-size: var(--text-s);
    color: var(--color-muted);
    line-height: 1.6;
  }
</style>
